# Порт, на котором поднимается сервер
PORT=3001

# Секрет для подписи JWT — обязательно замени на свою случайную строку в проде
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Путь к файлу базы данных SQLite (относительно корня backend/)
DB_PATH=./database.sqlite

# URL клиента для CORS (Electron/фронтенд AuraChat)
CLIENT_URL=http://localhost:3000

# Лимит размера загружаемых файлов, байты (10 МБ по умолчанию)
MAX_UPLOAD_SIZE=10485760

# TURN-сервер для звонков (Этап 1, только Electron) — креды от облачного провайдера
# (Twilio Network Traversal Service, Xirsys и т.п.). Если не задано — используется
# только публичный STUN Google, звонки будут работать напрямую P2P (в одной сети — ок,
# между разными сетями/провайдерами может не пройти без TURN).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Почта (подтверждение email) — Gmail SMTP через App Password.
# 1. Включи двухфакторку на Google-аккаунте
# 2. Создай App Password: https://myaccount.google.com/apppasswords
# 3. Впиши сюда свой gmail и сгенерированный 16-значный пароль (без пробелов)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=aurachat.support@gmail.com
SMTP_PASS=tbix qbmt zaom vvqk
SMTP_FROM=AuraChat <aurachat.support@gmail.com>

# Ключ для админ-панели (/admin.html и /api/admin/*) — придумай длинную случайную строку,
# никому кроме себя не показывай. Передаётся в заголовке X-Admin-Key.
ADMIN_API_KEY=27.01.2009.139.07